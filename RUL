        "# --- Test setindeki her motor için ayrı hata hesabı ---\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "\n",
        "def build_sequences_with_ids(data):\n",
        "    X, y, unit_ids_seq = [], [], []\n",
        "    for unitid, group in data.groupby('unitNum'):\n",
        "        sensordata = group[sensorcolumns].values\n",
        "        ruldata = group['RUL'].values\n",
        "        if len(sensordata) < seq_length:\n",
        "            continue\n",
        "        for i in range(len(sensordata) - seq_length):\n",
        "            X.append(sensordata[i:i+seq_length])\n",
        "            y.append(ruldata[i+seq_length])\n",
        "            unit_ids_seq.append(unitid)\n",
        "    return np.array(X), np.array(y), np.array(unit_ids_seq)\n",
        "\n",
        "# Test verisini unit id'leri de takip ederek yeniden oluştur\n",
        "X_test2, y_test2, test_unit_ids = build_sequences_with_ids(df_test)\n",
        "\n",
        "# Ölçekle (y_test2 zaten capped RUL, aynı scaler_y'yi kullan)\n",
        "y_test2_scaled = scaler_y.transform(y_test2.reshape(-1, 1))\n",
        "\n",
        "# Tahmin yap\n",
        "test_tahmin2 = model.predict(X_test2)\n",
        "gercek_test_tahmin2 = scaler_y.inverse_transform(test_tahmin2)\n",
        "gercek_test_tahmin2 = np.clip(gercek_test_tahmin2, 0, None)\n",
        "gercek_y_test2 = scaler_y.inverse_transform(y_test2_scaled)\n",
        "\n",
        "# Her motor için ayrı MAE ve RMSE hesapla\n",
        "results = []\n",
        "for uid in np.unique(test_unit_ids):\n",
        "    mask = test_unit_ids == uid\n",
        "    mae_u = mean_absolute_error(gercek_y_test2[mask], gercek_test_tahmin2[mask])\n",
        "    rmse_u = np.sqrt(mean_squared_error(gercek_y_test2[mask], gercek_test_tahmin2[mask]))\n",
        "    n_seq = mask.sum()\n",
        "    results.append((uid, n_seq, mae_u, rmse_u))\n",
        "\n",
        "results_df = pd.DataFrame(results, columns=['unitNum', 'n_sekans', 'MAE', 'RMSE'])\n",
        "results_df = results_df.sort_values('RMSE', ascending=False).reset_index(drop=True)\n",
        "\n",
        "print(\"Motorlar en kötüden en iyiye sıralı (RMSE'ye göre):\")\n",
        "display(results_df)\n",
        "\n",
        "print(f\"\\nOrtalama MAE: {results_df['MAE'].mean():.2f}\")\n",
