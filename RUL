      "cell_type": "code",
      "source": [
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "seq_length = 50\n",
        "sensorcolumns = [col for col in df.columns if col not in ['unitNum', 'timeCycle', 'RUL']]\n",
        "\n",
        "# --- motor ID'sine göre train/val/test ayrımı (leakage olmasın diye) ---\n",
        "unit_ids = df['unitNum'].unique()\n",
        "rng = np.random.default_rng(42)\n",
        "rng.shuffle(unit_ids)\n",
        "n = len(unit_ids)\n",
        "train_units = unit_ids[:int(n*0.75)]      # eski oranlarla aynı (%64 train, %16 val, %20 test)\n",
        "val_units   = unit_ids[int(n*0.75):int(n*0.85)]\n",
        "test_units  = unit_ids[int(n*0.85):]\n",
        "\n",
        "df_train = df[df['unitNum'].isin(train_units)].copy()\n",
        "df_val   = df[df['unitNum'].isin(val_units)].copy()\n",
        "df_test  = df[df['unitNum'].isin(test_units)].copy()\n",
        "\n",
        "# --- scaler sadece train'de fit ediliyor ---\n",
        "sc = StandardScaler()\n",
        "df_train[sensorcolumns] = sc.fit_transform(df_train[sensorcolumns])\n",
        "df_val[sensorcolumns]   = sc.transform(df_val[sensorcolumns])\n",
        "df_test[sensorcolumns]  = sc.transform(df_test[sensorcolumns])\n",
        "\n",
        "# --- pencereleri her split için ayrı ayrı oluştur ---\n",
        "def build_sequences(data):\n",
        "    X, y = [], []\n",
        "    for unitid, group in data.groupby('unitNum'):\n",
        "        sensordata = group[sensorcolumns].values\n",
        "        ruldata = group['RUL'].values\n",
        "        if len(sensordata) < seq_length:\n",
        "            continue\n",
        "        for i in range(len(sensordata) - seq_length):\n",
        "            X.append(sensordata[i:i+seq_length])\n",
        "            y.append(ruldata[i+seq_length])\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "X_train, y_train = build_sequences(df_train)\n",
        "X_val, y_val     = build_sequences(df_val)\n",
        "X_test, y_test   = build_sequences(df_test)\n",
        "\n",
        "print(\"X_train\", X_train.shape, \"X_val\", X_val.shape, \"X_test\", X_test.shape)"
      ],
