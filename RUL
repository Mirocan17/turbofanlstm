      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "url = \"https://raw.githubusercontent.com/AndreaPi/Analysis-of-NASA-Turbofan-Degradation-Data/refs/heads/master/data/train_FD001.txt\"\n",
        "columns = ['unitNum','timeCycle','Set1','Set2','Set3']+[f'Sen{i}' for i in range(1, 22)]\n",
        "df = pd.read_csv(url, sep='\\s+', header=None, names=columns)\n",
        "print(\"Shape = \",df.shape)\n",
        "display(df.head(5))\n",
        "print(df.columns)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "maxdf = df.groupby('unitNum')['timeCycle'].max().reset_index()\n",
        "maxdf.columns = ['unitNum', 'maxCycle']\n",
        "maxdf.head()\n",
        "df = pd.merge(df, maxdf, on='unitNum')\n",
        "df['RUL'] = df['maxCycle'] - df['timeCycle']\n",
        "df['RUL'] = df['RUL'].clip(upper=125)   # bunu ekle\n",
        "df = df.drop(columns=['maxCycle']) #redundant data"
      ],
